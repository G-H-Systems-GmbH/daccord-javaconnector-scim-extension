<?xml version="1.0" encoding="UTF-8"?>
<!--
    modifySecurityObject - changes a group (PATCH /Groups/{id}, one replace operation per attribute).

    Test call:
        java -Dlog4j2.level=DEBUG -jar <runnable-jar> modifysecurityobject examples/gpconnect.xml examples/securityobject-modify.xml

    <parameters> are identifiers and steering values (pp_config_<name> in the extension),
    <attributes> are SCIM attributes (pp_data_<name>).

    displayName is derived from securityobjectname when not given as attribute.
-->
<provisioning>
    <data>
        <attributes>
        </attributes>
    </data>
    <parameters>
        <parameter name="securityobjectuniqueid">YOUR_SCIM_GROUP_ID</parameter>
        <parameter name="securityobjectname">new-display-name</parameter>
    </parameters>
</provisioning>
