<?xml version="1.0" encoding="UTF-8"?>
<!--
    modifyAccountPassword - sets a new password (PATCH /Users/{id}, path password).

    Test call:
        java -Dlog4j2.level=DEBUG -jar <runnable-jar> modifyaccountpassword examples/gpconnect.xml examples/account-password.xml

    <parameters> are identifiers and steering values (pp_config_<name> in the extension),
    <attributes> are SCIM attributes (pp_data_<name>).

    In daccord PASSWORD arrives encrypted and is decrypted by the core. Servers that do not
    support the password attribute answer with an error, which is returned as is.
-->
<provisioning>
    <data>
        <attributes>
            <attribute name="PASSWORD">
                <value>YOUR_NEW_PASSWORD</value>
            </attribute>
        </attributes>
    </data>
    <parameters>
        <parameter name="accountuniqueid">YOUR_SCIM_USER_ID</parameter>
    </parameters>
</provisioning>
