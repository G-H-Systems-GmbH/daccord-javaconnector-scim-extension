<?xml version="1.0" encoding="UTF-8"?>
<!--
    reconcileAccount - reads the current state of a user (GET /Users/{id}).

    Test call:
        java -Dlog4j2.level=DEBUG -jar <runnable-jar> reconcileaccount examples/gpconnect.xml examples/account-reconcile.xml

    <parameters> are identifiers and steering values (pp_config_<name> in the extension),
    <attributes> are SCIM attributes (pp_data_<name>).

    Optional parameter reconcileattributes: comma-separated SCIM attributes (SCIM parameter attributes),
    default: all attributes the server returns by default. The user is returned below <object>;
    an attribute name that is no valid XML name (schema extension URN) becomes <attribute name="...">.
-->
<provisioning>
    <data>
        <attributes>
        </attributes>
    </data>
    <parameters>
        <parameter name="accountuniqueid">YOUR_SCIM_USER_ID</parameter>
    </parameters>
</provisioning>
