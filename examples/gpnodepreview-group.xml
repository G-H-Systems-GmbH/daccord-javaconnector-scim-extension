<?xml version="1.0" encoding="UTF-8"?>
<!--
    getNodePreview - first groups (same parameters as gpnodecollection-group.xml, prefix cp_).

    Test call:
        java -Dlog4j2.level=DEBUG -jar <runnable-jar> getnodepreview examples/gpconnect.xml examples/gpnodepreview-group.xml

    cp_param1 = collection type: accounts (GET /Users) | securityobjects (GET /Groups).
    In daccord the node name decides; cp_param1 overrides it for standalone tests.
    Page size: gp_param4 in gpconnect.xml (default 100).
-->
<parameters>
    <cp_params>
        <cp_param1>securityobjects</cp_param1>
    </cp_params>
</parameters>
